# Copie para .env e ajuste. O .env é ignorado pelo Git.
# A chave também pode ser salva pela tela de Configurações em uso local.
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_MODEL=
OPENAI_IMAGE_MODEL=

# Valor inicial do modo BERT; depois a tela de Configurações manda.
USE_BERT=0
# BERT_DIR=/caminho/para/bertimbau_enem

